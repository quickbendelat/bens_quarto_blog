# Block Quarto's background rendering logs and local metadata caches
/.quarto/
/posts/*/.quarto/

# Ignore local renv package binaries (renv.lock handles tracking them cleanly)
renv/library/
renv/local/
renv/staging/

# Ignore standard R project history trackers
.Rhistory
.RData
.Ruserdata

**/*.quarto_ipynb
.Rprofile
about.qmd
profile.jpg
README.md
renv.lock
_freeze/
renv/

# Block any untracked .qmd and .yml files inside the site output folder
_site/**/*.qmd
_site/**/*.yml

# Ignore the entire auto-generated static directory to prevent file duplication
_site/static/
_site/shared_code/
